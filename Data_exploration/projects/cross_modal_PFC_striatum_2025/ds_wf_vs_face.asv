nexttile
ds.make_bar_plot(cellfun(@(x)  x(:),temp_val,'UniformOutput',false),'ShowDots',0)
set(gca, 'XTick',[1:4],'XTickLabel', pairs_names);
ylim([0 1])
ylabel('Correlation')

