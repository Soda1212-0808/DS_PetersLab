            plot(temp_pupil_AUC_mean(temp_rxt_all==0,curr_pass),temp_wf_passive_max(temp_rxt_all==0,curr_pass),...
                'LineStyle','none','Marker','.','MarkerSize',10,'Color',[0.5 0.5 0.5])

            [R(curr_pass,1), p(curr_pass,1)] = corr(temp_pupil_AUC_mean(temp_rxt_all==0,curr_pass), temp_wf_passive_max(temp_rxt_all==0,curr_pass));
            [R(curr_pass,2), p(curr_pass,2)] = corr(temp_pupil_AUC_mean(temp_rxt_all==1,curr_pass), temp_wf_passive_max(temp_rxt_all==1,curr_pass));

            xlim([-0.15 0.3])
            ylim([0 0.0004])
            xlabel('AUC pupil')
            ylabel([roi1(passive_mode(curr_mode)).name 'max \Delta F/F'])
            axis square
        end

        sgtitle([groups_name{curr_group} '\_' modes_name{curr_mode}])
        drawnow

    end
end



